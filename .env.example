GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
TTS_BACKEND=gemini        # gemini | local | fake
LOCAL_TTS_ENGINE=piper    # piper | kokoro
PIPER_MODEL=              # path to a .onnx voice
WHISPER_MODEL=small

# Illustration source for the illustrated theme: iconify | google | gemini | none
IMAGE_SOURCE=pixabay,iconify   # comma list: first hit wins; pixabay needs PIXABAY_API_KEY
PIXABAY_API_KEY=
GOOGLE_SEARCH_API_KEY=            # Google Cloud API key with "Custom Search API" enabled
GOOGLE_CSE_ID=             # Programmable Search Engine ID (image search on)
GOOGLE_IMG_RIGHTS=cc_publicdomain|cc_attribute|cc_sharealike   # or: none (no licence filter)
ICONIFY_PREFIXES=fluent-emoji-flat,noto,twemoji,flat-color-icons,openmoji
